//@version=6
indicator("Capri Gold Intelligence v1", shorttitle="Capri Gold AI v1", overlay=true, max_labels_count=200)

// Research prototype only. No neural-network training, broker execution, or profitability claim.
// Designed for XAUUSD charts. Signals are hypotheses for manual review, not trade instructions.

string GROUP_TREND = "Trend and momentum"
int fastLen = input.int(21, "Fast EMA", minval=2, group=GROUP_TREND)
int slowLen = input.int(55, "Slow EMA", minval=3, group=GROUP_TREND)
int rsiLen = input.int(14, "RSI length", minval=2, group=GROUP_TREND)
int momLen = input.int(10, "Momentum lookback", minval=1, group=GROUP_TREND)

string GROUP_VOL = "Volatility and participation"
int atrLen = input.int(14, "ATR length", minval=2, group=GROUP_VOL)
int volLen = input.int(30, "Volume average length", minval=2, group=GROUP_VOL)
float highVolMult = input.float(1.5, "High-volatility threshold (ATR / ATR average)", minval=1.0, step=0.1, group=GROUP_VOL)

string GROUP_FILTER = "Optional cross-market context"
bool useUsd = input.bool(false, "Use USD index filter", group=GROUP_FILTER)
string usdSymbol = input.symbol("TVC:DXY", "USD index symbol", group=GROUP_FILTER)
bool useYield = input.bool(false, "Use nominal US 10Y yield filter (not real yield)", group=GROUP_FILTER)
string yieldSymbol = input.symbol("TVC:US10Y", "US 10Y yield symbol", group=GROUP_FILTER)

string GROUP_SIGNAL = "Signal controls"
int minScore = input.int(3, "Minimum absolute score", minval=1, maxval=6, group=GROUP_SIGNAL)
bool showLevels = input.bool(true, "Show prior confirmed swing levels", group=GROUP_SIGNAL)
int pivotLen = input.int(5, "Swing confirmation bars", minval=2, group=GROUP_SIGNAL)

float emaFast = ta.ema(close, fastLen)
float emaSlow = ta.ema(close, slowLen)
float rsi = ta.rsi(close, rsiLen)
float momentum = close - close[momLen]
float atr = ta.atr(atrLen)
float atrBase = ta.sma(atr, 50)
float atrRatio = atrBase > 0 ? atr / atrBase : na
float volBase = ta.sma(volume, volLen)
float relVolume = volBase > 0 ? volume / volBase : na

float usdClose = request.security(usdSymbol, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float usdChange = not na(usdClose) and not na(usdClose[momLen]) ? usdClose - usdClose[momLen] : na
float yieldClose = request.security(yieldSymbol, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float yieldChange = not na(yieldClose) and not na(yieldClose[momLen]) ? yieldClose - yieldClose[momLen] : na

bool trendUp = emaFast > emaSlow and close > emaFast
bool trendDown = emaFast < emaSlow and close < emaFast
bool momentumUp = momentum > 0 and rsi > 50
bool momentumDown = momentum < 0 and rsi < 50
bool usdHeadwind = useUsd and not na(usdChange) and usdChange > 0
bool usdTailwind = useUsd and not na(usdChange) and usdChange < 0
bool yieldHeadwind = useYield and not na(yieldChange) and yieldChange > 0
bool yieldTailwind = useYield and not na(yieldChange) and yieldChange < 0

int bullScore = (trendUp ? 1 : 0) + (momentumUp ? 1 : 0) + (usdTailwind ? 1 : 0) + (yieldTailwind ? 1 : 0)
int bearScore = (trendDown ? 1 : 0) + (momentumDown ? 1 : 0) + (usdHeadwind ? 1 : 0) + (yieldHeadwind ? 1 : 0)
int netScore = bullScore - bearScore

bool highVol = not na(atrRatio) and atrRatio >= highVolMult
bool longSetup = barstate.isconfirmed and netScore >= minScore
bool shortSetup = barstate.isconfirmed and netScore <= -minScore

float swingHigh = ta.pivothigh(high, pivotLen, pivotLen)
float swingLow = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(swingHigh)
    lastSwingHigh := swingHigh
if not na(swingLow)
    lastSwingLow := swingLow

plot(emaFast, "Fast EMA", color=color.new(color.teal, 0))
plot(emaSlow, "Slow EMA", color=color.new(color.orange, 0))
plot(showLevels ? lastSwingHigh : na, "Last confirmed swing high", color=color.new(color.red, 35), style=plot.style_stepline)
plot(showLevels ? lastSwingLow : na, "Last confirmed swing low", color=color.new(color.lime, 35), style=plot.style_stepline)

plotshape(longSetup, title="Bullish research condition", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny, text="BULL")
plotshape(shortSetup, title="Bearish research condition", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="BEAR")

bgcolor(highVol ? color.new(color.yellow, 90) : na, title="Elevated volatility regime")

var table panel = table.new(position.top_right, 2, 9, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "CAPRI GOLD", text_color=color.white, bgcolor=color.rgb(35, 45, 65))
    table.cell(panel, 1, 0, "RESEARCH v1", text_color=color.white, bgcolor=color.rgb(35, 45, 65))
    table.cell(panel, 0, 1, "Bias score")
    table.cell(panel, 1, 1, str.tostring(netScore) + " (+" + str.tostring(bullScore) + " / -" + str.tostring(bearScore) + ")")
    table.cell(panel, 0, 2, "Trend")
    table.cell(panel, 1, 2, trendUp ? "UP" : trendDown ? "DOWN" : "MIXED")
    table.cell(panel, 0, 3, "RSI")
    table.cell(panel, 1, 3, str.tostring(rsi, "#.0"))
    table.cell(panel, 0, 4, "ATR regime")
    table.cell(panel, 1, 4, highVol ? "ELEVATED" : "NORMAL")
    table.cell(panel, 0, 5, "Relative volume")
    table.cell(panel, 1, 5, na(relVolume) ? "N/A" : str.tostring(relVolume, "#.00") + "x")
    table.cell(panel, 0, 6, "USD filter")
    table.cell(panel, 1, 6, not useUsd ? "OFF" : na(usdChange) ? "NO DATA" : usdTailwind ? "GOLD SUPPORTIVE" : usdHeadwind ? "GOLD HEADWIND" : "FLAT")
    table.cell(panel, 0, 7, "10Y nominal filter")
    table.cell(panel, 1, 7, not useYield ? "OFF" : na(yieldChange) ? "NO DATA" : yieldTailwind ? "GOLD SUPPORTIVE" : yieldHeadwind ? "GOLD HEADWIND" : "FLAT")
    table.cell(panel, 0, 8, "State")
    table.cell(panel, 1, 8, longSetup ? "BULLISH CONDITION" : shortSetup ? "BEARISH CONDITION" : "NO CLEAR EDGE")

alertcondition(longSetup, "Capri bullish condition", "Capri Gold Intelligence: bullish research condition on {{ticker}} {{interval}}")
alertcondition(shortSetup, "Capri bearish condition", "Capri Gold Intelligence: bearish research condition on {{ticker}} {{interval}}")
